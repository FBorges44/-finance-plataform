APP_NAME=Finance Platform API
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://finance:finance_dev_password@127.0.0.1:5433/finance_platform
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:3000
AUTH_COOKIE_NAME=folio_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
FRONTEND_URL=http://localhost:3000
# SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD e SMTP_FROM_EMAIL são necessários para recuperação de senha.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080
